# Dependency directories (matches them anywhere in your subdirs)
node_modules/

# TypeScript compilation outputs (ignores compiled JS, source maps, and declaration files)
*.js
*.js.map
*.d.ts

# Alternatively, if you compile your code into specific output folders (like 'dist' or 'out')
dist/
out/

# IDE and Editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
